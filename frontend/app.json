{
  "expo": {
    "name": "Pinkberry Drc",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pinkberry.drc",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Localiser votre adresse et suivre la livraison",
        "NSPhotoLibraryUsageDescription": "Ajouter les photos de vos produits au catalogue"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.emergent.commanderose.bbj4fa",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#E6156F"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ajouter les photos de vos produits au catalogue"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Localiser votre adresse et suivre la livraison"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
